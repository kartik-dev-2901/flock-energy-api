{
  "openapi": "3.1.0",
  "info": {
    "title": "Flock Energy Meter API",
    "version": "1.0.0",
    "description": "A clean API over the legacy Urja Meter Ops portal. Meter listing, search, and details are served from a local meter-export snapshot; energy readings are fetched from the portal on demand."
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Local development server"
    }
  ],
  "tags": [
    {
      "name": "Health",
      "description": "Service health"
    },
    {
      "name": "Meters",
      "description": "Meter listing and metadata"
    },
    {
      "name": "Energy",
      "description": "Meter energy readings from the portal"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Check service health",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "The API process is healthy.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                },
                "example": {
                  "status": "ok",
                  "service": "flock-energy-api"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/meters": {
      "get": {
        "tags": [
          "Meters"
        ],
        "summary": "List and search meters",
        "operationId": "listMeters",
        "description": "Returns meters from the local in-memory index loaded from the meter export. The exact successful response structure is defined by the implementation of listMeters in src/meter.service.js.",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Optional search text.",
            "schema": {
              "type": "string",
              "default": ""
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "1-based page number.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Maximum number of records per page.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A page of meter results.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "Response object returned by listMeters().",
                  "additionalProperties": true
                }
              }
            }
          },
          "400": {
            "description": "Invalid query parameters.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvalidQueryError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/meters/{meterId}": {
      "get": {
        "tags": [
          "Meters"
        ],
        "summary": "Get meter details",
        "operationId": "getMeterById",
        "parameters": [
          {
            "name": "meterId",
            "in": "path",
            "required": true,
            "description": "Meter identifier.",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Meter metadata.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeterDetailResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid meter identifier.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvalidMeterIdError"
                }
              }
            }
          },
          "404": {
            "description": "Meter not found in the local index.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeterNotFoundError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/meters/{meterId}/energy": {
      "get": {
        "tags": [
          "Energy"
        ],
        "summary": "Get meter energy readings",
        "operationId": "getMeterEnergy",
        "description": "Fetches energy readings from the legacy portal on demand. The portal's observed measurement values are returned as strings.",
        "parameters": [
          {
            "name": "meterId",
            "in": "path",
            "required": true,
            "description": "Meter identifier.",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Energy readings for the requested meter.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EnergyResponse"
                },
                "example": {
                  "meterId": "J100000",
                  "count": 1,
                  "data": [
                    {
                      "timestamp": "24/06/2026 00:00",
                      "kwh": "48439.16",
                      "kvah": "52314.29",
                      "voltR": "229"
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid meter identifier.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvalidMeterIdError"
                }
              }
            }
          },
          "404": {
            "description": "Meter not found in the local index.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeterNotFoundError"
                }
              }
            }
          },
          "502": {
            "description": "The portal request failed or returned an unexpected response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UpstreamError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "required": [
          "status",
          "service"
        ],
        "properties": {
          "status": {
            "type": "string",
            "const": "ok"
          },
          "service": {
            "type": "string",
            "const": "flock-energy-api"
          }
        }
      },
      "Meter": {
        "type": "object",
        "description": "Meter metadata from the local export. Additional source fields may be present.",
        "properties": {
          "meterId": {
            "type": "string"
          },
          "serialNo": {
            "type": "string"
          },
          "make": {
            "type": "string"
          },
          "phaseType": {
            "type": "string"
          },
          "installStatus": {
            "type": "string"
          },
          "installType": {
            "type": "string"
          },
          "build": {
            "type": "string"
          },
          "dtCode": {
            "type": "string"
          },
          "hierarchy": {
            "type": "object",
            "additionalProperties": true
          },
          "geo": {
            "type": "object",
            "properties": {
              "lat": {
                "type": "number"
              },
              "lng": {
                "type": "number"
              }
            },
            "additionalProperties": true
          }
        },
        "required": [
          "meterId"
        ],
        "additionalProperties": true
      },
      "MeterDetailResponse": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "$ref": "#/components/schemas/Meter"
          }
        }
      },
      "EnergyReading": {
        "type": "object",
        "required": [
          "timestamp",
          "kwh",
          "kvah",
          "voltR"
        ],
        "properties": {
          "timestamp": {
            "type": "string",
            "description": "Timestamp in the portal's observed DD/MM/YYYY HH:mm format.",
            "example": "24/06/2026 00:00"
          },
          "kwh": {
            "type": "string",
            "description": "kWh reading as returned by the portal."
          },
          "kvah": {
            "type": "string",
            "description": "kVAh reading as returned by the portal."
          },
          "voltR": {
            "type": "string",
            "description": "Red-phase voltage value as returned by the portal."
          }
        },
        "additionalProperties": false
      },
      "EnergyResponse": {
        "type": "object",
        "required": [
          "meterId",
          "count",
          "data"
        ],
        "properties": {
          "meterId": {
            "type": "string"
          },
          "count": {
            "type": "integer",
            "minimum": 0
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EnergyReading"
            }
          }
        }
      },
      "InvalidQueryError": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message",
              "details"
            ],
            "properties": {
              "code": {
                "type": "string",
                "const": "INVALID_QUERY"
              },
              "message": {
                "type": "string"
              },
              "details": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      },
      "InvalidMeterIdError": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string",
                "const": "INVALID_METER_ID"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      },
      "MeterNotFoundError": {
        "type": "object",
        "required": [
          "error",
          "meterId"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string",
                "const": "METER_NOT_FOUND"
              },
              "message": {
                "type": "string"
              }
            }
          },
          "meterId": {
            "type": "string"
          }
        }
      },
      "UpstreamError": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "UPSTREAM_ERROR",
                  "INVALID_UPSTREAM_RESPONSE"
                ]
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
